# --- Server ---
PORT=4000
# Public address of THIS api (used to build upload URLs). No trailing slash.
PUBLIC_API_URL=http://localhost:4000
# Address of the React site. Several allowed, comma separated. No trailing slash.
FRONTEND_URL=http://localhost:5173

# --- Database ---
# Local default. For Atlas, replace this value with the Atlas connection string below.
MONGODB_URI=mongodb://127.0.0.1:27017/artist-site
# Atlas format: mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/artist-site?retryWrites=true&w=majority

# --- Admin login (used by `npm run seed`) ---
# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=
# Where order and message notifications go (defaults to ADMIN_EMAIL)
ADMIN_NOTIFY_EMAIL=

# --- Paystack (leave empty to take orders by bank transfer only) ---
PAYSTACK_SECRET_KEY=
# Shown in emails when an order has not been paid online
BANK_DETAILS=Bank name, account number, account name

# --- Email (leave SMTP_HOST empty in development: emails print in the terminal) ---
# Gmail:  smtp.gmail.com / 587 / false / your gmail / 16-character app password
# Resend: smtp.resend.com / 465 / true / resend / your Resend API key
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Artist Name <you@example.com>"
